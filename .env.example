PORT=3000
MONGODB_URI=
JWT_SECRET=
EMAIL_USER=
EMAIL_APP_PASSWORD=
# production | development — enables stricter startup checks (MONGODB_URI
# and JWT_SECRET become required) and a couple of prod-only response headers.
NODE_ENV=development
# Comma-separated list of allowed browser origins, e.g.
# https://fomo.app,https://www.fomo.app — leave unset for local dev (allows
# all origins). Native app requests (Capacitor) aren't affected either way.
ALLOWED_ORIGINS=

# Shared secret for POST /api/marbella-events/sync (see SYNC_SECRET comment
# in .env). Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SYNC_SECRET=
